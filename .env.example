# Local development only. Change every credential before deployment.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgresql://dayline:dayline_dev@127.0.0.1:5432/dayline
TEST_DATABASE_URL=postgresql://dayline:dayline_dev@127.0.0.1:5432/dayline_test
POSTGRES_USER=dayline
POSTGRES_PASSWORD=dayline_dev
POSTGRES_DB=dayline
POSTGRES_PORT=5432

AUTH_BASE_URL=http://localhost:3000
AUTH_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:3000
WEB_BASE_URL=http://localhost:5173
BETTER_AUTH_SECRET=local-development-only-replace-before-production

# file is a development preview, not an email queue. It never sends mail.
MAIL_TRANSPORT=file
MAIL_PREVIEW_DIR=.local/mail
MAIL_FROM=Dayline <noreply@example.com>
RESEND_API_KEY=

# Optional: WeChat endpoints fail explicitly until both server credentials are configured.
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_MINIAPP_SCAN_PAGE=pages/scan/confirm
WECHAT_MINIAPP_ENV=release
