# Optional HOST Caddy configuration. This is not a service inside the app container.
# Set SITE_URL in the host Caddy service environment, or replace the site address.
{$SITE_URL} {
  encode zstd gzip
  header {
    -Server
    Referrer-Policy no-referrer
    X-Content-Type-Options nosniff
    X-Frame-Options DENY
  }
  log {
    output stdout
    format filter {
      wrap json
      fields {
        request>uri replace /redacted
        request>headers delete
        resp_headers delete
      }
    }
  }
  reverse_proxy 127.0.0.1:13000
}
