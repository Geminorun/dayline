# Copy this CONTENT into the GitHub production Environment secret APP_ENV.
# This is not the local development .env. Values are literal dotenv strings; quote # and spaces.
POSTGRES_CONTAINER=your-existing-postgres17-container
POSTGRES_PASSWORD='your-supplied-application-database-password'
BETTER_AUTH_SECRET=change-me-to-an-independent-random-secret-of-at-least-32-characters
ACTION_PROOF_SECRET=change-me-to-a-different-random-secret-of-at-least-32-characters
RESEND_API_KEY=your-resend-sending-key
MAIL_FROM='Dayline <noreply@your-verified-domain.example>'

# Optional: existing database administrator, only used inside the existing PG container.
# POSTGRES_ADMIN_USER=postgres
# POSTGRES_ADMIN_PASSWORD='only-if-local-socket-authentication-requires-it'
# Optional defaults. Existing application passwords are verified, never automatically rotated.
# POSTGRES_DB=dayline
# POSTGRES_USER=dayline
# APP_PORT=13000
# DEPLOY_PROJECT=dayline
# Nginx and its certificates are managed on the host.
# Keep Cloudflare DNS proxy enabled and select SSL/TLS Full (strict).

# Optional: configure this pair together when the small program is ready.
# WECHAT_APP_ID=wx-your-app-id
# WECHAT_APP_SECRET=your-server-side-wechat-secret
# WECHAT_MINIAPP_ENV=trial
