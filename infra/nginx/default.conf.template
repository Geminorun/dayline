# Generated for this release. Do not log verification/reset credentials in URLs.
access_log off;
error_log /dev/null;
server_tokens off;
include /etc/nginx/dayline/cloudflare-real-ip.conf;

resolver 127.0.0.11 valid=5s ipv6=off;
upstream dayline {
    zone dayline 64k;
    server app:3000 resolve;
    keepalive 16;
}

server {
    listen 127.0.0.1:8080;
    location = /health/nginx { return 200 'ready'; }
    location / { return 404; }
}

server {
    listen 80;
    server_name @SITE_HOST@;
    return 308 @SITE_URL@$request_uri;
}

server {
    listen 443 ssl;
    server_name @SITE_HOST@;
    ssl_certificate /etc/nginx/tls/tls.crt;
    ssl_certificate_key /etc/nginx/tls/tls.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 16m;
    gzip on;
    gzip_vary on;
    gzip_types application/json application/javascript text/css;

    location / {
        proxy_pass http://dayline;
        proxy_http_version 1.1;
        proxy_set_header Connection '';
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_connect_timeout 5s;
        proxy_read_timeout 75s;
        proxy_send_timeout 75s;
        proxy_request_buffering off;
        proxy_buffering off;
    }
}
