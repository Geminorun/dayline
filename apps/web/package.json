    "dexie": "4.2.1",
    "sortablejs": "1.15.7",
    "vue": "3.5.44",
    "vue-i18n": "11.4.16",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@types/sortablejs": "1.15.9",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.4.6",
    "fake-indexeddb": "6.2.5",
    "jsdom": "29.1.1",
