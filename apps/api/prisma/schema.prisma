generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                     String                @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  name                   String
  email                  String
  emailVerified          Boolean               @default(false) @map("email_verified")
  image                  String?
  createdAt              DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  emailKind              String                @default("real") @map("email_kind")
  status                 String                @default("active")
  authEpoch              Int                   @default(1) @map("auth_epoch")
  profileVersion         Int                   @default(1) @map("profile_version")
  deletionDueAt          DateTime?             @map("deletion_due_at") @db.Timestamptz(3)
  dataVersion            BigInt                @default(1) @map("data_version")
  initializedAt          DateTime?             @map("initialized_at") @db.Timestamptz(3)
  mergedIntoUserId       String?               @map("merged_into_user_id") @db.Uuid
  mergedInto             User?                 @relation("MergedUsers", fields: [mergedIntoUserId], references: [id], onDelete: Cascade)
  mergedSources          User[]                @relation("MergedUsers")
  emailBindingRequests   EmailBindingRequest[]
  initiatedMergeContexts MergeContext[]        @relation("ContextInitiator")
  otherMergeContexts     MergeContext[]        @relation("ContextOther")
  initiatedMerges        AccountMerge[]        @relation("MergeInitiator")
  sourceMerges           AccountMerge[]        @relation("MergeSource")
  targetMerges           AccountMerge[]        @relation("MergeTarget")
  importJobs             ImportJob[]
  categories             Category[]
  entries                Entry[]
  sessions               Session[]
  accounts               Account[]
  wechatIdentities       WechatIdentity[]

  @@unique([email])
  @@index([status, deletionDueAt])
  @@index([mergedIntoUserId])
  @@map("users")
}

model Session {
  id         String   @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  token      String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  userId     String   @map("user_id") @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  authEpoch  Int      @default(1) @map("auth_epoch")
  authMethod String   @default("email_password") @map("auth_method")

  @@unique([token])
  @@index([userId])
  @@map("auth_sessions")
}

model Account {
  id                    String    @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("auth_accounts")
}

model Verification {
  id         String   @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier])
  @@map("auth_verifications")
}

model WechatIdentity {
  id        String   @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  appId     String   @map("app_id")
  openid    String
  unionid   String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([appId, openid])
  @@unique([userId, appId])
  @@map("wechat_identities")
}

model QrRequest {
  id                 String   @id @db.Uuid
  purpose            String
  status             String   @default("pending")
  browserSecretHash  String   @map("browser_secret_hash")
  sceneHash          String   @unique @map("scene_hash")
  scannerSecretHash  String?  @map("scanner_secret_hash")
  scannerAppId       String?  @map("scanner_app_id")
  scannerOpenid      String?  @map("scanner_openid")
  scannerUnionid     String?  @map("scanner_unionid")
  initiatorUserId    String?  @map("initiator_user_id") @db.Uuid
  initiatorSessionId String?  @map("initiator_session_id") @db.Uuid
  initiatorAuthEpoch Int?     @map("initiator_auth_epoch")
  actionContext      Json?    @map("action_context")
  result             Json?
  confirmedUserId    String?  @map("confirmed_user_id") @db.Uuid
  expiresAt          DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("qr_requests")
}

model Category {
  id        String   @id @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  color     String
  seedKey   String?  @map("seed_key")
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  entries   Entry[]

  @@unique([userId, name])
  @@unique([id, userId])
  @@unique([userId, seedKey])
  @@map("categories")
}

model Entry {
  id           String          @id @db.Uuid
  userId       String          @map("user_id") @db.Uuid
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId   String          @map("category_id") @db.Uuid
  category     Category        @relation(fields: [categoryId, userId], references: [id, userId], onDelete: NoAction)
  title        String
  startDate    DateTime        @map("start_date") @db.Date
  endDate      DateTime?       @map("end_date") @db.Date
  version      Int             @default(1)
  focusVersion Int             @default(1) @map("focus_version")
  deletedAt    DateTime?       @map("deleted_at") @db.Timestamptz(3)
  purgeAfter   DateTime?       @map("purge_after") @db.Timestamptz(3)
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  focusDays    EntryFocusDay[]

  @@index([userId, startDate, id])
  @@index([userId, categoryId])
  @@index([userId, deletedAt])
  @@map("entries")
}

model EntryFocusDay {
  entryId   String   @map("entry_id") @db.Uuid
  entry     Entry    @relation(fields: [entryId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  focused   Boolean
  version   Int      @default(1)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@id([entryId, date])
  @@map("entry_focus_days")
}

model ImportJob {
  id                String    @id @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind              String
  clientOperationId String    @map("client_operation_id") @db.Uuid
  inputDigest       String    @map("input_digest")
  authEpoch         Int       @map("auth_epoch")
  status            String    @default("preview")
  input             Json?
  plan              Json
  receipt           Json?
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  completedAt       DateTime? @map("completed_at") @db.Timestamptz(3)

  @@unique([userId, clientOperationId])
  @@index([userId, inputDigest])
  @@index([status, expiresAt])
  @@map("import_jobs")
}

model EmailBindingRequest {
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  id          String    @id @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  sessionId   String    @map("session_id") @db.Uuid
  authEpoch   Int       @map("auth_epoch")
  operationId String    @map("operation_id") @db.Uuid
  email       String
  tokenHash   String    @map("token_hash")
  status      String    @default("pending")
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  verifiedAt  DateTime? @map("verified_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([userId, operationId])
  @@index([status, expiresAt])
  @@map("email_binding_requests")
}

model MergeContext {
  initiator       User     @relation("ContextInitiator", fields: [initiatorUserId], references: [id], onDelete: Cascade)
  other           User     @relation("ContextOther", fields: [otherUserId], references: [id], onDelete: Cascade)
  id              String   @id @db.Uuid
  initiatorUserId String   @map("initiator_user_id") @db.Uuid
  otherUserId     String   @map("other_user_id") @db.Uuid
  sessionId       String   @map("session_id") @db.Uuid
  operationId     String   @map("operation_id") @db.Uuid
  initiatorEpoch  Int      @map("initiator_epoch")
  otherEpoch      Int      @map("other_epoch")
  expiresAt       DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([initiatorUserId, operationId])
  @@map("merge_contexts")
}

model AccountMerge {
  initiator         User                @relation("MergeInitiator", fields: [initiatorUserId], references: [id], onDelete: Cascade)
  source            User                @relation("MergeSource", fields: [sourceUserId], references: [id], onDelete: Cascade)
  target            User                @relation("MergeTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  mapping           MergeRecordMapping?
  id                String              @id @db.Uuid
  initiatorUserId   String              @map("initiator_user_id") @db.Uuid
  sourceUserId      String              @map("source_user_id") @db.Uuid
  targetUserId      String              @map("target_user_id") @db.Uuid
  operationId       String              @map("operation_id") @db.Uuid
  contextId         String              @map("context_id") @db.Uuid
  sourceEpoch       Int                 @map("source_epoch")
  targetEpoch       Int                 @map("target_epoch")
  sourceDataVersion BigInt              @map("source_data_version")
  targetDataVersion BigInt              @map("target_data_version")
  status            String              @default("preview")
  plan              Json
  recoverySnapshot  Json?               @map("recovery_snapshot")
  recoveryExpiresAt DateTime?           @map("recovery_expires_at") @db.Timestamptz(3)
  expiresAt         DateTime            @map("expires_at") @db.Timestamptz(3)
  completedAt       DateTime?           @map("completed_at") @db.Timestamptz(3)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([initiatorUserId, operationId])
  @@index([targetUserId, status])
  @@index([sourceUserId, status])
  @@map("account_merges")
}

model MergeRecordMapping {
  merge    AccountMerge @relation(fields: [mergeId], references: [id], onDelete: Cascade)
  mergeId  String       @id @map("merge_id") @db.Uuid
  mappings Json

  @@map("merge_record_mappings")
}
