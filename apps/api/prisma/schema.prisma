generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String           @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  name             String
  email            String
  emailVerified    Boolean          @default(false) @map("email_verified")
  image            String?
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  emailKind        String           @default("real") @map("email_kind")
  status           String           @default("active")
  authEpoch        Int              @default(1) @map("auth_epoch")
  profileVersion   Int              @default(1) @map("profile_version")
  deletionDueAt    DateTime?        @map("deletion_due_at") @db.Timestamptz(3)
  sessions         Session[]
  accounts         Account[]
  wechatIdentities WechatIdentity[]

  @@unique([email])
  @@index([status, deletionDueAt])
  @@map("users")
}

model Session {
  id         String   @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  token      String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  userId     String   @map("user_id") @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  authEpoch  Int      @default(1) @map("auth_epoch")
  authMethod String   @default("email_password") @map("auth_method")

  @@unique([token])
  @@index([userId])
  @@map("auth_sessions")
}

model Account {
  id                    String    @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("auth_accounts")
}

model Verification {
  id         String   @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier])
  @@map("auth_verifications")
}

model WechatIdentity {
  id        String   @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  appId     String   @map("app_id")
  openid    String
  unionid   String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([appId, openid])
  @@unique([userId, appId])
  @@map("wechat_identities")
}

model QrRequest {
  id                String   @id @db.Uuid
  purpose           String
  status            String   @default("pending")
  browserSecretHash String   @map("browser_secret_hash")
  sceneHash         String   @unique @map("scene_hash")
  scannerSecretHash String?  @map("scanner_secret_hash")
  scannerAppId      String?  @map("scanner_app_id")
  scannerOpenid     String?  @map("scanner_openid")
  scannerUnionid    String?  @map("scanner_unionid")
  confirmedUserId   String?  @map("confirmed_user_id") @db.Uuid
  expiresAt         DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("qr_requests")
}
