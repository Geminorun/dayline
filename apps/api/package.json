{
  "name": "@dayline/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "build": "nest build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "auth:schema": "auth generate --config src/auth/auth-schema.ts --adapter prisma --dialect postgresql --output prisma/auth.generated.prisma --yes"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "1.7.13",
    "@dayline/contracts": "workspace:*",
    "@dayline/core": "workspace:*",
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/swagger": "11.4.7",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@thallesp/nestjs-better-auth": "2.8.0",
    "better-auth": "1.7.13",
    "dotenv": "^17.0.0",
    "express": "^5.1.0",
    "helmet": "^8.0.0",
    "jose": "6.2.13",
    "nestjs-i18n": "10.8.5",
    "pg": "^8.0.0",
    "prisma": "7.10.1",
    "reflect-metadata": "^0.2.2",
    "resend": "6.34.1",
    "rxjs": "^7.8.0",
    "zod": "^4.0.0",
    "@dayline/locales": "workspace:*"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@types/express": "^5.0.0",
    "@types/express-serve-static-core": "^5.1.3",
    "@types/pg": "^8.0.0",
    "@types/supertest": "^6.0.0",
    "auth": "1.7.13",
    "supertest": "^7.0.0"
  },
  "files": [
    "dist",
    "prisma",
    "prisma.config.ts"
  ]
}
