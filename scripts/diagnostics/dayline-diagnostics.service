[Unit]
Description=Collect a sanitized Dayline diagnostic snapshot
After=docker.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/sbin/dayline-diagnostics-snapshot
TimeoutStartSec=45
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/dayline-diagnostics
